{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "KillaCoreFileUpload": {
    "SecretKey": "My-Super-Secret-Key-Must-Be-Long",
    "TempFolder": "MyCustomAppUploads",

    // Root limits: what any upload context gets unless a profile says otherwise.
    "MaxFileBytes": 10485760,
    "AllowedMimeTypes": [ "image/jpeg", "image/png", "application/pdf" ],

    // Hard transport ceiling for Kestrel and multipart parsing. Keep at or above the
    // largest profile limit.
    "MaxRequestBytes": 524288000,

    // Per-context overrides, keyed by the client's UploadContext.
    "Profiles": {
      // Set "StreamDirectToStorage": true here to hand SaveFileAsync the request body itself:
      // one write instead of two, at the cost of duplicate detection for this context.
      "TestUpload": {
        "MaxFileBytes": 209715200
      }
    }
  },

  "AllowedHosts": "*"
}
